# =============================================================================
# Nea — agente de agendamiento para WhatsApp · variables de entorno
# Copia este archivo a `.env` y reemplaza los REEMPLAZA_...
# En Coolify, estas mismas variables van en el runtime del contenedor.
# =============================================================================

# --- Webhook de Meta ---------------------------------------------------------

# Token que TÚ inventas y pegas igual en la configuración del webhook de la app
# de Meta (developers.facebook.com → WhatsApp → Configuration → Verify token).
VERIFY_TOKEN=REEMPLAZA_token_secreto_de_verificacion

# App Secret de la app de Meta (Settings → Basic → App Secret). Si tiene valor,
# se verifica la firma x-hub-signature-256 de cada POST (inválida → 401).
# Opcional: déjalo vacío solo en desarrollo local.
META_APP_SECRET=

# --- CRM (vocero-crm, bot gateway /api/bot/*) --------------------------------

# URL base del CRM (sin / final). Ej: https://crm.tu-negocio.com
CRM_BASE_URL=REEMPLAZA_https://tu-crm

# URL COMPLETA del webhook del CRM, incluyendo el segmento del verify token
# del CRM. El bot le releva el payload crudo de Meta con la firma intacta.
# Ej: https://crm.tu-negocio.com/api/webhooks/wa/EL_VERIFY_TOKEN_DEL_CRM
CRM_WEBHOOK_URL=REEMPLAZA_https://tu-crm/api/webhooks/wa/token

# API key de servicio del CRM (BOT_API_KEY en el .env del CRM; genera con
# `openssl rand -hex 32`). Va en el header X-API-Key de cada llamada /api/bot/*.
# En modo despacho (ver abajo) es TAMBIÉN el secreto compartido con el que se
# firma/verifica cada POST /dispatch.
CRM_BOT_API_KEY=REEMPLAZA_api_key_de_32_bytes

# --- Modo de despacho multi-organización (Vocero multitenant) ---------------
#
# `POST /dispatch` se monta SIEMPRE (no hay bandera de modo) y convive con el
# webhook de Meta de siempre — organization_id NULL sigue siendo el camino
# legacy de un solo negocio. Es la ruta que usa un Vocero multitenant: el CRM
# ya recibió el webhook de Meta de TODAS sus organizaciones, lo guardó, hizo
# su propio debounce, y le despacha el turno a esta Nea compartida.
#
# No hay nada que configurar de ESTE lado más que CRM_BOT_API_KEY (arriba): el
# CRM apunta su NEA_DISPATCH_URL a http://<este-host>:8000/dispatch y comparte
# la MISMA CRM_BOT_API_KEY (así firma cada despacho y Nea la verifica).

# Corte de un despliegue de UN SOLO negocio a modo despacho (p. ej. allok
# migrando su propio número, que le sigue llegando a Nea por un override de
# Meta): desplegar con RELAY_ONLY=true justo cuando el CRM empiece a mandar
# NEA_DISPATCH_URL. /webhook sigue verificando firma, persistiendo y releando
# cada payload al CRM exactamente igual que hoy, pero deja de correr turnos
# (sin coalesce, sin "escribiendo…") — el CRM va a correr ESE turno por
# /dispatch. Sin este corte, durante la transición el lead recibe la misma
# respuesta DOS veces (una del webhook clásico, otra del despacho). Default
# false: comportamiento de siempre.
RELAY_ONLY=false

# Despliegue de SOLO-despacho puro (esta Nea nunca recibe el webhook de Meta
# directamente): no hacen falta VERIFY_TOKEN, META_APP_SECRET ni
# CRM_WEBHOOK_URL. DISPATCH_ONLY=true es la bandera EXPLÍCITA que lo permite —
# CRM_BOT_API_KEY por sí solo NO alcanza como señal (lo tiene cualquier
# despliegue normal, así que dejaría arrancar en verde a un despliegue
# clásico que se quedó sin META_APP_SECRET por error, y Meta empezaría a
# recibir 401 en cada entrega sin que nada avise). Con DISPATCH_ONLY=true:
# el arranque con persistencia ya NO exige META_APP_SECRET, pero entonces
# POST /webhook rechaza TODO con 401 en vez de aceptar payloads sin firma (un
# secreto vacío deja de significar "dev, no verifiques" en cuanto la bandera
# dice que esta instancia no habla con Meta). Default false: sin esta
# bandera, un despliegue con DB y sin META_APP_SECRET sigue sin poder
# arrancar — igual que siempre.
#
# DISPATCH_ONLY=true SIN DATABASE_URL (PR 2B, despacho v2): arranca sin
# Postgres, sin migraciones y sin los workers de fondo (relay/followup/
# sender, todos legacy) — solo corren /dispatch (versión 2; la 1 responde
# 503, claro) y /health ("db": "none"). Es el modo de un despliegue de
# despacho v2 puro, donde el CRM manda todo lo que Nea necesita en cada
# turno y no hace falta persistencia propia.
DISPATCH_ONLY=false

# Cutover de leads existentes: esta Nea ya atendía a UN negocio en modo
# legacy (organization_id NULL) antes de que ese negocio se sumara al
# despacho multi-organización. Sin esto, el primer turno que el CRM despache
# para ESE negocio crearía una conversación NUEVA bajo (orgId, identidad) —
# el lead pierde su historial y su "greeted", y cualquier followup legacy ya
# agendado sigue disparando por el cliente global en vez del de su
# organización. Con LEGACY_ORGANIZATION_ID puesto, al arrancar (después de
# migrar) se adoptan TODAS las filas legacy hacia ese organization_id — una
# vez, de forma idempotente (arranques siguientes no encuentran nada que
# mover). Ponla el día del corte, junto con RELAY_ONLY=true:
#   1. RELAY_ONLY=true + LEGACY_ORGANIZATION_ID=<id de la organización
#      principal en el CRM> en el mismo deploy.
#   2. Reiniciar Nea: el log debe decir cuántas filas adoptó.
#   3. El CRM empieza a mandar NEA_DISPATCH_URL para esa organización.
# Vacío (default) = no hace nada; segura de dejar puesta después del corte.
LEGACY_ORGANIZATION_ID=

# --- Perfil del negocio ------------------------------------------------------

# Nombre del agente si el CRM no define uno (el agent profile de Vocero manda).
AGENT_NAME=Nea

# Zona horaria IANA para las fechas que ve el LLM.
AGENT_TIMEZONE=America/Caracas

# Markdown local con el brief del negocio (ver examples/brief.example.md).
# Fallback: solo se usa si el CRM no expone /api/bot/profile o está caído.
BRIEF_PATH=

# --- LLM (OpenAI) ------------------------------------------------------------

# API key de OpenAI (platform.openai.com → API keys).
OPENAI_API_KEY=REEMPLAZA_sk-...

# Modelo para las respuestas en vivo. Usa un modelo RÁPIDO, no "razonador"
# (gotcha del selftest: los razonadores tardan y devuelven content vacío).
OPENAI_MODEL=gpt-4o-mini

# Alternativa OpenAI-compatible. Si tiene token, OpenRouter tiene prioridad
# sobre OPENAI_API_KEY/OPENAI_MODEL para las respuestas de texto.
OPENROUTER_API_TOKEN=
OPENROUTER_MODEL=

# Cuántos mensajes recientes del historial se le pasan al LLM por turno.
HISTORY_WINDOW=10

# --- Guardarraíles y tiempos -------------------------------------------------

# Allowlist de pruebas: CSV de identidades de WhatsApp (teléfonos con lada,
# ej 5215512345678, o BSUIDs). Con valor, el bot SOLO responde a esas
# identidades (el resto se releva al CRM sin respuesta). Vacíala SOLO para
# salir a producción — decisión explícita del dueño.
ALLOWED_WA_IDS=REEMPLAZA_5215512345678

# Segundos de coalescencia: una ráfaga de mensajitos = UNA respuesta.
COALESCE_SECONDS=4

# Segundos entre recibir un mensaje y mostrar "escribiendo…" (antes del coalesce).
TYPING_DELAY_SECONDS=0.5

# Horas de silencio del lead antes del ÚNICO empujón de seguimiento.
FOLLOWUP_HOURS=4

# --- Infra -------------------------------------------------------------------

# Postgres PROPIO del bot (no el del CRM). Las migraciones corren al arranque.
# Ej: postgresql://nea:password@localhost:5432/nea
DATABASE_URL=REEMPLAZA_postgresql://usuario:password@host:5432/nea

# Puerto del servidor (healthcheck: GET /health).
PORT=8000

# Desarrollo: loguear el JSON crudo de mensajes no-texto para capturar
# formatos reales de Meta. Apagar en producción.
CAPTURE_PAYLOADS=false

# --- Harness de pruebas en vivo (opcional; SOLO local, jamás en producción) --
# WAHA controla una línea tester TUYA para conversar con el bot en el canal
# real (selftest/waha.py). Usa una key limitada a la sesión con read + send.
WAHA_BASE_URL=https://waha-demo.frontia.app
WAHA_SESSION=demo-nea-pilot
WAHA_API_KEY=REEMPLAZA_key_scoped_de_la_sesion
# Número al que escribe el tester (único destino permitido)
LIVE_TARGET_NUMBER=REEMPLAZA_52XXXXXXXXXX
